<%- include('../partials/head') %>
<%- include('_nav') %>
<% const p = product; %>
<div class="container section">
  <h1><%= title %></h1>
  <%- include('../partials/errors') %>
  <form class="panel" action="/admin/produits<%= p.id ? '/' + p.id : '' %>" method="post" enctype="multipart/form-data">
    <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
    <div class="form-grid">
      <div class="field full"><label for="name">Nom</label><input id="name" name="name" type="text" required maxlength="120" value="<%= p.name || '' %>"></div>
      <div class="field">
        <label for="game">Jeu</label>
        <select id="game" name="game"><% for (const [k, g] of Object.entries(GAMES)) { %><option value="<%= k %>" <%= p.game === k ? 'selected' : '' %>><%= g.label %></option><% } %></select>
      </div>
      <div class="field">
        <label for="category">Type</label>
        <select id="category" name="category"><% for (const [k, l] of Object.entries(CATEGORIES)) { %><option value="<%= k %>" <%= p.category === k ? 'selected' : '' %>><%= l %></option><% } %></select>
      </div>
      <div class="field"><label for="setName">Extension</label><input id="setName" name="setName" type="text" maxlength="120" value="<%= p.set_name || '' %>"></div>
      <div class="field"><label for="cardNumber">Numéro</label><input id="cardNumber" name="cardNumber" type="text" maxlength="30" value="<%= p.card_number || '' %>"></div>
      <div class="field"><label for="rarity">Rareté</label><input id="rarity" name="rarity" type="text" maxlength="60" value="<%= p.rarity || '' %>"></div>
      <div class="field"><label for="grading">Gradation (ex. PSA 10)</label><input id="grading" name="grading" type="text" maxlength="40" value="<%= p.grading || '' %>"></div>
      <div class="field">
        <label for="condition">État</label>
        <select id="condition" name="condition"><% for (const [k, c] of Object.entries(CONDITIONS)) { %><option value="<%= k %>" <%= p.condition === k ? 'selected' : '' %>><%= c.label %></option><% } %></select>
      </div>
      <div class="field">
        <label for="language">Langue</label>
        <select id="language" name="language"><% for (const [k, l] of Object.entries(LANGUAGES)) { %><option value="<%= k %>" <%= p.language === k ? 'selected' : '' %>><%= l %></option><% } %></select>
      </div>
      <div class="field"><label for="price">Prix (€)</label><input id="price" name="price" type="number" step="0.01" min="0.01" required value="<%= p.price_cents ? (p.price_cents / 100).toFixed(2) : (p.price || '') %>"></div>
      <div class="field"><label for="stock">Stock</label><input id="stock" name="stock" type="number" min="0" step="1" required value="<%= p.stock ?? 0 %>"></div>
      <div class="field full"><label for="description">Description</label><textarea id="description" name="description" maxlength="4000"><%= p.description || '' %></textarea></div>
      <fieldset class="field full gallery-admin">
        <legend>Photos (<%= gallery.filter((g) => !g.legacy).length %>/<%= maxImages %>)</legend>
        <% if (gallery.length) { %>
          <ul class="gallery-admin-list">
            <% gallery.forEach((img, i) => { %>
              <li>
                <div class="thumb thumb-lg"><img src="<%= img.sm.url %>" alt="" width="<%= img.sm.width %>" height="<%= img.sm.height %>"></div>
                <% if (img.legacy) { %>
                  <p class="small muted">Ancienne photo : elle sera convertie (WebP, 3 tailles) à l’enregistrement.</p>
                  <label class="checkbox small"><input type="checkbox" name="removeLegacyImage"> Supprimer</label>
                <% } else { %>
                  <label class="checkbox small"><input type="radio" name="cover" value="<%= img.id %>" <%= i === 0 ? 'checked' : '' %>> Photo principale</label>
                  <label class="sr-only" for="alt-<%= img.id %>">Légende de la photo <%= i + 1 %></label>
                  <input id="alt-<%= img.id %>" name="alt_<%= img.id %>" type="text" maxlength="120" value="<%= img.alt %>" placeholder="Légende (ex. Verso)">
                  <label class="checkbox small"><input type="checkbox" name="remove_<%= img.id %>"> Supprimer</label>
                <% } %>
              </li>
            <% }) %>
          </ul>
        <% } %>
        <label for="images">Ajouter des photos — JPG, PNG ou WebP, 10 Mo max chacune</label>
        <input id="images" name="images" type="file" accept="image/jpeg,image/png,image/webp" multiple>
        <p class="small muted">Recto, verso, détails des coins… Les photos sont converties en WebP et leurs métadonnées (GPS, appareil) supprimées.</p>
      </fieldset>
      <div class="field"><label class="checkbox"><input type="checkbox" name="isFeatured" <%= p.is_featured ? 'checked' : '' %>> ★ Mettre en avant (pièce rare, page d’accueil)</label></div>
      <div class="field"><label class="checkbox"><input type="checkbox" name="active" <%= p.active ? 'checked' : '' %>> En ligne</label></div>
      <div class="field full filters-row">
        <button class="btn btn-primary" type="submit">Enregistrer</button>
        <a class="btn btn-ghost" href="/admin/produits">Annuler</a>
      </div>
    </div>
  </form>
  <% if (p.id && p.active) { %>
    <form action="/admin/produits/<%= p.id %>/archiver" method="post" data-confirm="Retirer ce produit de la boutique ?">
      <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
      <button class="btn btn-danger btn-sm" type="submit">Archiver le produit</button>
    </form>
  <% } %>
</div>
<%- include('../partials/foot') %>
