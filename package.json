{
  "name": "holovault",
  "version": "1.0.0",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node scripts/seed.js",
    "create-admin": "node scripts/create-admin.js",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "pentest": "node security/pentest.js",
    "audit": "npm audit --omit=dev --audit-level=low",
    "security": "npm run audit && npm run lint && npm test && npm run pentest",
    "lint": "eslint . --max-warnings=0",
    "test:coverage": "node --test --test-concurrency=1 --experimental-test-coverage --test-coverage-exclude=\"tests/**\" \"tests/**/*.test.js\"",
    "migrate": "node scripts/migrate.js",
    "backup": "node scripts/backup.js"
  },
  "author": "",
  "license": "UNLICENSED",
  "description": "Boutique en ligne de cartes TCG (Pokémon, Yu-Gi-Oh!, Magic, One Piece, Lorcana)",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "supertest": "^7.3.1"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
