# --- Application ---
NODE_ENV=production
PORT=3000
BASE_URL=https://votre-domaine.fr
SHOP_NAME=HoloVault
# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Nombre de reverse proxies devant l'app (1 si Nginx/Caddy)
TRUST_PROXY=1
DATABASE_PATH=./data/shop.db
UPLOAD_DIR=./data/uploads

# --- PayPal (https://developer.paypal.com > Apps & Credentials) ---
# mock = simulation locale (interdit en production) | sandbox = tests | live = réel
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# ID du webhook créé dans le dashboard PayPal (URL : https://votre-domaine.fr/api/paypal/webhook)
PAYPAL_WEBHOOK_ID=

# --- E-mails (optionnel) ---
# SMTP_URL=smtps://utilisateur:motdepasse@smtp.exemple.fr:465
SMTP_URL=
MAIL_FROM="HoloVault <commandes@votre-domaine.fr>"
